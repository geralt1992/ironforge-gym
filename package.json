  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.2"
